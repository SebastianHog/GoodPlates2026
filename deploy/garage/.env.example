# Copy to .env next to docker-compose.yml and replace each CHANGE_ME
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
GARAGE_METRICS_TOKEN=CHANGE_ME
GARAGE_DEFAULT_BUCKET=goodplates
GARAGE_DEFAULT_ACCESS_KEY=CHANGE_ME
GARAGE_DEFAULT_SECRET_KEY=CHANGE_ME
# Optional, where garage.toml and the image data live on the host
GARAGE_HOST_DIR=/opt/garage
